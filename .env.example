# Project environment: dev | prod
ENVIRONMENT=dev

# Django settings
DJANGO_SECRET_KEY=your_secret_key_here
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# DJANGO_CSRF_TRUSTED_ORIGINS=https://example.com
# DJANGO_LOG_LEVEL=INFO

# Database settings (по умолчанию — sqlite, для PostgreSQL раскомментируйте)
# DATABASE_URL=postgres://app:app@localhost:5432/app

# Postgres (используется docker-compose)
POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=app

# Redis settings
REDIS_URL=redis://localhost:6379/1
REDIS_HOST=localhost
REDIS_PORT=6379

# Production security (используются при ENVIRONMENT=prod)
# DJANGO_SECURE_SSL_REDIRECT=True
# DJANGO_SECURE_HSTS_SECONDS=2592000
# GUNICORN_WORKERS=4
